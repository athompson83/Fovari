# Public local mobile configuration only. Never add a service-role key here.
EXPO_PUBLIC_APP_ENV=local
EXPO_PUBLIC_DATA_MODE=demo
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=local-anon-key-from-supabase-status

# Server-only local values are documented separately and must never use EXPO_PUBLIC_.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
