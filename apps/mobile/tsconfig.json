{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "allowJs": false,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "strict": true,
    "types": ["vitest/globals"]
  },
  "include": [
    ".expo/types/**/*.ts",
    "app.config.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "expo-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx"
  ]
}
