{
  "name": "@fovari/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "android": "expo run:android",
    "build": "expo export --platform web --output-dir dist",
    "clean": "rimraf dist .expo coverage",
    "dev": "expo start",
    "ios": "expo run:ios",
    "lint": "eslint app src app.config.ts --max-warnings 0 --no-error-on-unmatched-pattern",
    "start": "expo start",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "web": "expo start --web"
  },
  "dependencies": {
    "@expo/vector-icons": "15.1.1",
    "@fovari/api-client": "workspace:*",
    "@fovari/design-system": "workspace:*",
    "@fovari/domain": "workspace:*",
    "@fovari/validation": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@tanstack/react-query": "5.101.4",
    "expo": "~57.0.8",
    "expo-blur": "~57.0.2",
    "expo-constants": "~57.0.7",
    "expo-crypto": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.4",
    "expo-router": "~57.0.8",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "7.82.0",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/react": "~19.2.2",
    "eslint": "10.7.0",
    "jsdom": "29.1.1",
    "rimraf": "6.1.3",
    "typescript": "~6.0.3",
    "vitest": "4.1.10"
  }
}
